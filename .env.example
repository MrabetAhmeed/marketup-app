# ──────────────────────────────────────────────────────────────
# MARKET-UP / vivasky.media — Environment variables (reference)
#
# Local:   copy to .env.local and fill in.
# Servers: set the same names in the host's variable manager.
#
# Legend
#   [START]      missing or invalid = the server REFUSES TO START
#                (and `next build` fails: the build validates them too)
#   [NEVER-PROD] must never be set on the production server
#
# No real value belongs in this file: examples are fictitious.
# A value containing # MUST be quoted (dotenv reads # as a comment).
# ──────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────

# [START] Required. No default.
# Use the long form, WITHOUT +srv, with explicit hosts and the database name:
#   mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/DB_NAME?ssl=true&replicaSet=NAME&authSource=admin
# The database name in this URI decides which data the server reads and writes.
MONGODB_URI=


# ── Authentication (NextAuth) ─────────────────────────────────

# [START] if not a valid URL. Default: http://localhost:3000
# Public URL of THIS server. Used in every email link and in the payment
# return/webhook links. Left to its default on a server: links point to localhost.
NEXTAUTH_URL=http://localhost:3000

# [START] Required. No default. Signs the sessions.
# Long random string, different on every environment.
NEXTAUTH_SECRET=


# ── Emails (SMTP via Nodemailer) ──────────────────────────────

# Optional. If SMTP_HOST or SMTP_USER is empty: NO email is sent,
# a warning is logged, and nothing fails (signup codes never arrive).
SMTP_HOST=
# [START] if not an integer. Default: 465
SMTP_PORT=465
# Optional: true | false. Default: true when SMTP_PORT=465, false otherwise.
# SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender address. Default: onboarding@resend.dev (a placeholder — set a real one).
EMAIL_FROM=no-reply@example.com
# Where admin notifications are sent. Default: manager@vivasky.media
ADMIN_NOTIFICATION_EMAIL=manager@vivasky.media


# ── File storage ──────────────────────────────────────────────

# [START] if not one of: local | cloudinary | r2. Default: local
#   local      = files written on the server disk (public/uploads): lost on redeploy.
#   cloudinary = the only choice for a server.
#   r2         = NOT implemented: every upload fails.
STORAGE_ADAPTER=cloudinary

# Required when STORAGE_ADAPTER=cloudinary. Empty: the server starts,
# then every upload fails ("Cloudinary credentials not configured").
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# [START] if not a positive integer. Default: 5 (megabytes)
UPLOAD_MAX_SIZE_MB=5


# ── Monetization ──────────────────────────────────────────────

# Optional: true | 1 = purchases open. Anything else or absent = closed (fail-safe).
# Closed: no purchase; past orders stay visible; payment return and webhook still work.
# MONETIZATION_ENABLED=false


# ── Payment ───────────────────────────────────────────────────

# [START] Required in EVERY environment, no default: simulated | flouci
PAYMENT_ADAPTER=simulated

# [START] FORBIDDEN COMBINATION: NODE_ENV=production (any `next start`)
#   + MONETIZATION_ENABLED=true + PAYMENT_ADAPTER=simulated
#   The simulator would hand out services for free.
#   A deployed server with purchases open must use flouci.

# [START] if it lists anything else than: card, wallet. Default: card
# With Flouci this only drives accept_card ("card" listed = cards accepted).
# The Flouci wallet cannot be switched off here: it depends on the merchant account.
PAYMENT_ACCEPTED_METHODS=card

# [START] if not a positive integer. Default: 1200 (seconds)
PAYMENT_SESSION_TIMEOUT_SECONDS=1200

# Simulator only. [START] if not: success | failure. Default: success
# Outcome of every simulated payment. Ignored with flouci.
PAYMENT_SIMULATED_OUTCOME=success

# ── Payment: Flouci (all [START] when PAYMENT_ADAPTER=flouci) ──
# Also required then: NEXTAUTH_URL must be https and must not be localhost.
# Keys are server-only: never prefix them with NEXT_PUBLIC_.
# Test keys = Flouci "TEST APP". Production keys = real money.
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
# Must be https. Host only, the same in test and production:
#   https://developers.flouci.com
FLOUCI_BASE_URL=
# test | production. Declarative (the keys decide): recorded on every order
# and printed at startup. Must match the keys above.
FLOUCI_ENVIRONMENT=
# At least 32 characters each. Random, different on every environment.
# PAYMENT_WEBHOOK_SECRET is part of the webhook URL given to Flouci.
PAYMENT_WEBHOOK_SECRET=
# Reserved for the payment sweep (not used yet), but already required with flouci.
PAYMENT_SWEEP_SECRET=


# ── Backup and purge ──────────────────────────────────────────

# Optional. Empty = the backup route answers an error and nothing is backed up.
# Target cluster, long form WITHOUT +srv and WITHOUT a database name.
BACKUP_MONGODB_URI=
# Optional. Empty = the backup route refuses every call. Long random string.
BACKUP_CRON_SECRET=
# [START] if not an integer >= 0. Default: 7 (days)
# The backup job also deletes signup documents older than this that no company
# of THIS database references. Two servers sharing one Cloudinary account but
# not one database would delete each other's files: configure the backup on
# ONE server per Cloudinary account only.
SIGNUP_TEMP_MAX_AGE_DAYS=7


# ── Legal documents ───────────────────────────────────────────

# Optional. [START] if not a valid URL. Hosted externally, fetched and proxied.
# A #fragment scrolls to that section on load.
# QUOTES ARE MANDATORY when the URL contains # (dotenv reads # as a comment).
# Defaults (shown below) all point to the combined document:
# MENTIONS_LEGALES_SOURCE_URL="https://static.vivasky.media/cgu_cgv.html#mentions-legales"
# CGU_SOURCE_URL="https://static.vivasky.media/cgu_cgv.html#cgu"
# CGV_SOURCE_URL="https://static.vivasky.media/cgu_cgv.html#cgv"
# CONFIDENTIALITE_SOURCE_URL="https://static.vivasky.media/cgu_cgv.html#confidentialite"


# ── Host / runtime (set by the host or by Next.js, not by the app) ──

# NODE_ENV: set by Next.js (development for `next dev`, production for
#   `next build` and `next start`). Do not set it by hand.
# NEXT_RUNTIME: set by Next.js itself. Never set it.
# NEXT_PHASE: set by Next.js itself. Never set it.
# NODE_OPTIONS: on the Infomaniak container, --max-old-space-size=1536
#   (build and start). Without it the build runs out of memory.


# ── Scripts only (never read by the running application) ──────

# [NEVER-PROD] Lets db:seed and db:reset DROP every collection of MONGODB_URI.
# Must be exactly "true". Uncomment on a development machine only.
# ALLOW_DESTRUCTIVE_SEED=true

# db:seed-prod only: initial admin password. Prefer the masked prompt
# (leave unset). Never keep it in a file, never type it on a command line.
# ADMIN_INITIAL_PASSWORD=

# [NEVER-PROD as a stored variable] restore script only. Must be "1".
# Pass it on the command line for the one run, never store it:
#   RESTORE_ALLOWED=1 npx tsx --env-file=<env file> scripts/restore.ts
# RESTORE_ALLOWED=


# ── Declared but without effect today ─────────────────────────
# Accepted by the configuration, read by no feature. Leave them unset.

# Real-time notifications (not wired).
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=eu

# Upload type lists (the accepted types are fixed in the code).
# UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# UPLOAD_ALLOWED_DOC_TYPES=application/pdf

# Cloudflare R2 (adapter not implemented — see STORAGE_ADAPTER).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=marketup-uploads
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://cdn.example.com
