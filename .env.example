# ──────────────────────────────────────────────
# MARKET-UP — Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# MongoDB Atlas — connection string
MONGODB_URI=

# NextAuth v4 stable
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# SMTP (transactional email via Nodemailer)
SMTP_HOST=
SMTP_PORT=465
# SMTP_SECURE=       # Optional — auto-inferred: true for port 465, false otherwise
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
ADMIN_NOTIFICATION_EMAIL=manager@vivasky.media

# Monetization (absent or false = OFF — fail-safe)
# MONETIZATION_ENABLED=false
# PAYMENT_ADAPTER=simulated

# Pusher (real-time)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# Storage (local | cloudinary | r2)
STORAGE_ADAPTER=cloudinary

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_ALLOWED_DOC_TYPES=application/pdf

# Scripts — destructive seed/reset guard (required for db:seed and db:reset)
ALLOW_DESTRUCTIVE_SEED=true

# Production seed — admin initial password (required for db:seed-prod only)
# ADMIN_INITIAL_PASSWORD=

# Legal pages — hosted externally, fetched and proxied by the app
# Accepts a full URL with optional #fragment (scroll to section on load)
# Default: all point to the combined CGU/CGV document on static.vivasky.media
# To switch to separate files: change the URL without fragment, no code change needed
# IMPORTANT: guillemets OBLIGATOIRES si l'URL contient un # (dotenv traite # comme commentaire)
# MENTIONS_LEGALES_SOURCE_URL="https://static.vivasky.media/cgu_cgv.html#mentions-legales"
# CGU_SOURCE_URL="https://static.vivasky.media/cgu_cgv.html#cgu"
# CGV_SOURCE_URL="https://static.vivasky.media/cgu_cgv.html#cgv"
# CONFIDENTIALITE_SOURCE_URL="https://static.vivasky.media/cgu_cgv.html#confidentialite"

# Cloudflare R2 (S3-compatible — only needed when STORAGE_ADAPTER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=marketup-uploads
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.vivasky.media
