# ──────────────────────────────────────────────
# MARKET-UP — Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# MongoDB Atlas — connection string
MONGODB_URI=

# NextAuth v4 stable
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=mrabet.ahmeed@gmail.com

# Pusher (real-time)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# Storage (local filesystem for V1, r2 for V1.1)
STORAGE_ADAPTER=local
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_ALLOWED_DOC_TYPES=application/pdf

# Cloudflare R2 (S3-compatible — only needed when STORAGE_ADAPTER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=marketup-uploads
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.vivasky.media
