{
  "name": "marketup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync-shared": "rm -rf public/shared && cp -r reference/mockups/shared public/shared",
    "predev": "npm run sync-shared",
    "prebuild": "npm run sync-shared",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:reset": "npx tsx scripts/reset.ts"
  },
  "dependencies": {
    "mongoose": "9.6.2",
    "next": "14.2.35",
    "next-auth": "4.24.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "20.19.41",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.31.0",
    "postcss": "8.5.14",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
